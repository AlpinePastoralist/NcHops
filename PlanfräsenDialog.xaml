<Window x:Class="NCHops.PlanfräsenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Planfräsen Parameter" Width="420" SizeToContent="Height" MinWidth="420" MinHeight="360" MaxHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Werkzeugauswahl -->
        <Label Grid.Row="0" Grid.Column="0" Content="Werkzeug:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CbWerkzeug"
                  DisplayMemberPath="DisplayName" VerticalAlignment="Center"
                  SelectionChanged="OnWerkzeugSelected" Margin="0,0,0,0"/>

        <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,6"/>

        <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="X0:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtX0" Text="-35" VerticalAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Y0:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtY0" Text="-35" VerticalAlignment="Center"/>

                <Label Grid.Row="2" Grid.Column="0" Content="X1:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtX1" VerticalAlignment="Center"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Y1:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtY1" VerticalAlignment="Center"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Z-Tiefe:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtZ" Text="0" VerticalAlignment="Center"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Fräser-D:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtFraeserD" Text="35" VerticalAlignment="Center"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Zustellfaktor:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtFaktor" Text="0.75" VerticalAlignment="Center"/>

                <Label Grid.Row="7" Grid.Column="0" Content="Vorschub:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtVorschub" Text="1000" VerticalAlignment="Center"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Drehzahl:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtDrehzahl" Text="8000" VerticalAlignment="Center"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
            <RadioButton x:Name="RbHorizontal" Content="Horizontal" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="OnOrientationChanged"/>
            <RadioButton x:Name="RbVertikal" Content="Vertikal" Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnOrientationChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="0,0,8,0" Click="OnOk" IsDefault="True"/>
            <Button Content="Abbrechen" Width="85" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
