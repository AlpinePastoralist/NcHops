<Window x:Class="NCHops.WerkzeugeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NCHops"
        Title="Werkzeugliste" Width="860" Height="460"
        MinWidth="650" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#d8e0ea">
    <Window.Resources>
        <local:UnitValueConverter x:Key="UC"/>

        <!-- ── Farb-Ressourcen (angelehnt an MainWindow) ─────────────── -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#DDD0B0"/>
        <SolidColorBrush x:Key="AccentHoverBrush"  Color="#E6DBBF"/>
        <SolidColorBrush x:Key="AccentPressBrush"  Color="#CEC09E"/>
        <SolidColorBrush x:Key="AccentTintBrush"   Color="#FCF9F2"/>
        <SolidColorBrush x:Key="BgBrush"           Color="#d8e0ea"/>
        <SolidColorBrush x:Key="BgLightBrush"      Color="#eaecf2"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#a8b4c0"/>
        <SolidColorBrush x:Key="TextDarkBrush"     Color="#6A5430"/>
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#3A2C10"/>

        <!-- ── Button ─────────────────────────────────────────────── -->
        <Style TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentPressBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid ───────────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource BgLightBrush}"/>
            <Setter Property="RowBackground"             Value="{StaticResource BgLightBrush}"/>
            <Setter Property="AlternatingRowBackground"  Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush"               Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="HorizontalGridLinesBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush"    Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground"                Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="RowHeight"                 Value="26"/>
            <Setter Property="FontSize"                  Value="12"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="6,6"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentPressBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="{StaticResource AccentTintBrush}"/>
                    <Setter Property="Foreground"  Value="{StaticResource TextDarkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TabControl / TabItem ──────────────────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="14,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="{StaticResource BgLightBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Margin="2,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── Kopfleiste ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⛭" FontSize="17" Margin="0,0,8,0"
                           Foreground="{StaticResource TextOnAccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitel" Text="Werkzeugliste" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextOnAccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Fußleiste ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnWaehlen" Content="Auswählen" Width="100" Margin="0,0,8,0"
                        Visibility="Collapsed" IsDefault="True"
                        Click="OnWaehlen"/>
                <Button Content="Schließen" Width="90"
                        Click="OnSchliessen" IsCancel="True"/>
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <TabControl x:Name="TabWerkzeuge" SelectedIndex="0">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Einzelansicht" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="LstWerkzeuge" Grid.Column="0" Margin="0,0,10,0"
                                 DisplayMemberPath="ListLabel"
                                 SelectionChanged="OnEinzelSelectionChanged"
                                 MouseDoubleClick="OnEinzelListDoubleClick"/>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedItem, ElementName=LstWerkzeuge}" Margin="4">
                                <Border Width="180" Height="180" HorizontalAlignment="Left"
                                        Background="{StaticResource BgLightBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,0,8">
                                    <Image x:Name="ImgVorschau" Stretch="Uniform" Margin="4"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="Bild wählen..." Width="120" Click="OnBildWaehlen" Margin="0,0,8,0"/>
                                    <Button Content="Bild entfernen" Width="120" Click="OnBildEntfernen"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Typ" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Typ}" VerticalAlignment="Center" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4"
                                               Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Durchmesser Ø" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4"
                                               Text="{Binding Durchmesser, Converter={StaticResource UC}, ConverterParameter='F2|mm', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Schneidenwinkel" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,4"
                                               Text="{Binding Schneidenwinkel, Converter={StaticResource UC}, ConverterParameter='F2|°', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Z+ Zustellung" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,4"
                                               Text="{Binding ZZustellung, Converter={StaticResource UC}, ConverterParameter='F2|mm', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Eintauchwinkel" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,4"
                                               Text="{Binding Eintauchwinkel, Converter={StaticResource UC}, ConverterParameter='F2|°', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Vorschub XY" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="6" Grid.Column="1" Margin="0,4"
                                               Text="{Binding VorschubFxy, Converter={StaticResource UC}, ConverterParameter='F0|mm/min', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Vorschub Z" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="7" Grid.Column="1" Margin="0,4"
                                               Text="{Binding VorschubFz, Converter={StaticResource UC}, ConverterParameter='F0|mm/min', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Drehzahl" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="8" Grid.Column="1" Margin="0,4"
                                               Text="{Binding Drehzahl, Converter={StaticResource UC}, ConverterParameter='F0|upm', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Räumzustellung XY+" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="9" Grid.Column="1" Margin="0,4"
                                               Text="{Binding RaeumzustellungXY, Converter={StaticResource UC}, ConverterParameter='F1|%', UpdateSourceTrigger=LostFocus}"
                                               LostFocus="OnEinzelFeldGeaendert"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fräser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid x:Name="WerkzeugGridFraeser"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalScrollBarVisibility="Auto"
                              PreparingCellForEdit="OnWerkzeugCellPreparing"
                              PreviewKeyDown="OnWerkzeugKeyDown"
                              PreviewMouseRightButtonDown="OnWerkzeugGridRightClick"
                              InitializingNewItem="OnWerkzeugInitializingNewItem"
                              CellEditEnding="OnWerkzeugCellEditEnding"
                              MouseDoubleClick="OnWerkzeugGridDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="▲ Eine Zeile nach oben"  Click="OnZeileHoch"/>
                                <MenuItem Header="▼ Eine Zeile nach unten" Click="OnZeileRunter"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr"   Binding="{Binding Nr}"   Width="32"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="Ø"
                                Binding="{Binding Durchmesser,    Converter={StaticResource UC}, ConverterParameter='F2|mm'}"     Width="65"/>
                            <DataGridTextColumn Width="72">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Schneidenwinkel">∨ α</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Schneidenwinkel" Converter="{StaticResource UC}" ConverterParameter="F2|°"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="65">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Z+ Zustellung">⌐ Z+</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ZZustellung" Converter="{StaticResource UC}" ConverterParameter="F2|mm"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="65">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Eintauchwinkel">↘ α</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Eintauchwinkel" Converter="{StaticResource UC}" ConverterParameter="F2|°"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="85">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Vorschub XY">→ Fxy</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="VorschubFxy" Converter="{StaticResource UC}" ConverterParameter="F0|mm/min"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="80">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Vorschub Z">↓ Fz</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="VorschubFz" Converter="{StaticResource UC}" ConverterParameter="F0|mm/min"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="75">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Drehzahl">↻ S</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Drehzahl" Converter="{StaticResource UC}" ConverterParameter="F0|upm"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="75">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Räumzustellung XY+">□ XY+</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="RaeumzustellungXY" Converter="{StaticResource UC}" ConverterParameter="F1|%"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Geändert" Width="110" IsReadOnly="True"
                                Binding="{Binding Geaendert, StringFormat='dd.MM.yyyy HH:mm'}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊕" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bohrer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid x:Name="WerkzeugGridBohrer"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalScrollBarVisibility="Auto"
                              PreparingCellForEdit="OnWerkzeugCellPreparing"
                              PreviewKeyDown="OnWerkzeugKeyDown"
                              PreviewMouseRightButtonDown="OnWerkzeugGridRightClick"
                              InitializingNewItem="OnWerkzeugInitializingNewItem"
                              CellEditEnding="OnWerkzeugCellEditEnding"
                              MouseDoubleClick="OnWerkzeugGridDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="▲ Eine Zeile nach oben"  Click="OnZeileHoch"/>
                                <MenuItem Header="▼ Eine Zeile nach unten" Click="OnZeileRunter"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr"   Binding="{Binding Nr}"   Width="32"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="Ø"
                                Binding="{Binding Durchmesser,    Converter={StaticResource UC}, ConverterParameter='F2|mm'}"     Width="65"/>
                            <DataGridTextColumn Width="72">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Schneidenwinkel">∨ α</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Schneidenwinkel" Converter="{StaticResource UC}" ConverterParameter="F2|°"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="65">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Z+ Zustellung">⌐ Z+</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ZZustellung" Converter="{StaticResource UC}" ConverterParameter="F2|mm"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="65">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Eintauchwinkel">↘ α</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Eintauchwinkel" Converter="{StaticResource UC}" ConverterParameter="F2|°"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="85">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Vorschub XY">→ Fxy</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="VorschubFxy" Converter="{StaticResource UC}" ConverterParameter="F0|mm/min"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="80">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Vorschub Z">↓ Fz</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="VorschubFz" Converter="{StaticResource UC}" ConverterParameter="F0|mm/min"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="75">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Drehzahl">↻ S</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Drehzahl" Converter="{StaticResource UC}" ConverterParameter="F0|upm"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="75">
                                <DataGridTextColumn.Header>
                                    <TextBlock ToolTip="Räumzustellung XY+">□ XY+</TextBlock>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="RaeumzustellungXY" Converter="{StaticResource UC}" ConverterParameter="F1|%"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Geändert" Width="110" IsReadOnly="True"
                                Binding="{Binding Geaendert, StringFormat='dd.MM.yyyy HH:mm'}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
