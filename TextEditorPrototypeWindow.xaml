<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NCHops.TextEditorPrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Textfeld-Prototype: Character-basiertes Modell + Layout-Engine"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#2d2d30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#3e3e42" Margin="15">
            <TextBlock Foreground="White" FontSize="14" FontWeight="Bold">
                Prototype: Verbesserte Text-Editor Architektur
            </TextBlock>
            <TextBlock Foreground="#cccccc" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap">
                ✓ Character-basiertes Datenmodell  ✓ TextLayoutEngine mit Zeilenumbruch  ✓ Multi-Format Support
            </TextBlock>
        </StackPanel>

        <!-- Haupt-Editor -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Editor-Canvas -->
            <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#555555" BorderThickness="1">
                <skia:SKElement x:Name="EditorCanvas" Margin="0"/>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3e3e42"/>

            <!-- Properties Panel -->
            <ScrollViewer Grid.Column="2" Background="#252526">
                <StackPanel Margin="10">
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,10">Eigenschaften</TextBlock>

                    <TextBlock Foreground="#cccccc" FontSize="11" Margin="0,0,0,5">Schriftart:</TextBlock>
                    <ComboBox x:Name="CmbFontFamily" Margin="0,0,0,10" Height="25" Background="#3c3c3c" Foreground="White" SelectedIndex="0" SelectionChanged="OnFormatChanged">
                        <ComboBoxItem>Segoe UI</ComboBoxItem>
                        <ComboBoxItem>Arial</ComboBoxItem>
                        <ComboBoxItem>Courier New</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Foreground="#cccccc" FontSize="11" Margin="0,0,0,5">Größe (pt):</TextBlock>
                    <Slider x:Name="SldFontSize" Minimum="8" Maximum="48" Value="12" Background="#3c3c3c" Margin="0,0,0,10" ValueChanged="OnFormatChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Weiß" Padding="8,5" Margin="0,0,5,0" Background="#FFFFFF" Click="OnColorClick" Foreground="Black"/>
                        <Button Content="Schwarz" Padding="8,5" Background="#000000" Click="OnColorClick" Foreground="White"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkBold" Foreground="White" Content="Fett" Checked="OnFormatChanged" Unchecked="OnFormatChanged" Margin="0,0,0,5"/>
                    <CheckBox x:Name="ChkItalic" Foreground="White" Content="Kursiv" Checked="OnFormatChanged" Unchecked="OnFormatChanged" Margin="0,0,0,10"/>

                    <TextBlock Foreground="#cccccc" FontSize="11" Margin="0,0,0,8">Feldbreite:</TextBlock>
                    <Slider x:Name="SldContainerWidth" Minimum="100" Maximum="600" Value="400" Background="#3c3c3c" Margin="0,0,0,10" ValueChanged="OnLayoutChanged"/>

                    <TextBlock Foreground="#999999" FontSize="10" Margin="0,20,0,5" FontWeight="Bold">Debug:</TextBlock>
                    <TextBox x:Name="TxtInfo" Height="80" Background="#1e1e1e" Foreground="#00ff00" IsReadOnly="True" Padding="5" FontFamily="Courier New" FontSize="9" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Background="#3e3e42" Margin="15" Orientation="Horizontal">
            <TextBlock Foreground="#cccccc" FontSize="11" VerticalAlignment="Center">Text eingeben, auswählen, formatieren, Feldbreite ändern für Zeilenumbruch</TextBlock>
            <Button Margin="15,0,0,0" Padding="10,8" Click="OnExport" Content="Export" Background="#0e639c" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
