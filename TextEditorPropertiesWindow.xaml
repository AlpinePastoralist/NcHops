<Window x:Class="NCHops.TextEditorPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Editor mit Eigenschaften" Height="500" Width="800"
        Background="#2a2a2a" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- Text Editor -->
        <Border Grid.Column="0" Background="#1e1e1e" Margin="5">
            <ContentControl x:Name="TextEditorControl" />
        </Border>

        <!-- Eigenschaften Panel -->
        <Border Grid.Column="1" Background="#252526" Margin="5" Padding="10">
            <StackPanel>
            <TextBlock Text="Text-Eigenschaften" FontSize="14" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,0,0,10" />

            <!-- Rendering-Stil -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Rendering-Stil:" FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,5" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FillRadio" Content="Fill" GroupName="Style"
                                 Foreground="White" VerticalAlignment="Center" Checked="OnStyleChanged" Margin="0,0,10,0" />
                    <RadioButton x:Name="StrokeRadio" Content="Stroke" GroupName="Style"
                                 Foreground="White" VerticalAlignment="Center" Checked="OnStyleChanged" />
                </StackPanel>
            </StackPanel>

            <!-- Farbe -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Farbe:" FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,5" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ColorWhiteBtn" Content="Weiß" Width="50" Padding="5"
                            Background="#4a4a4a" Click="OnColorWhiteClick" Margin="0,0,5,0" />
                    <Button x:Name="ColorBlackBtn" Content="Schwarz" Width="60" Padding="5"
                            Background="#4a4a4a" Click="OnColorBlackClick" Margin="0,0,5,0" />
                    <Button x:Name="ColorRedBtn" Content="Rot" Width="50" Padding="5"
                            Background="#4a4a4a" Click="OnColorRedClick" />
                </StackPanel>
            </StackPanel>

            <!-- Stroke-Breite -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Stroke-Breite:" FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,5" />
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="StrokeWidthSlider" Width="150" Minimum="0.1" Maximum="5"
                            Value="0.5" ValueChanged="OnStrokeWidthChanged" Margin="0,0,5,0" />
                    <TextBlock x:Name="StrokeWidthLabel" Text="0.5" Width="40" Foreground="White" />
                </StackPanel>
            </StackPanel>

            <!-- Export zu Liniensegmenten -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Export:" FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,5" />
                <Button x:Name="ConvertToLineSegmentsBtn" Content="Text zu Liniensegmenten"
                        Padding="8" Background="#0e639c" Foreground="White" Click="OnConvertToLineSegments" />
                <TextBlock x:Name="ExportInfoText" Text="" FontSize="9" Foreground="#909090" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>

                <!-- Debug Info -->
                <Separator Background="#404040" Margin="0,5,0,5" />
                <TextBlock Text="Debug Info:" FontSize="11" Foreground="#909090" Margin="0,0,0,5" />
                <TextBlock x:Name="DebugText" Text="" FontSize="10" Foreground="#707070" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
