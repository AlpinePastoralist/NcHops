<Window x:Class="NCHops.BohrungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bohrung" Width="420" Height="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Eingabefelder -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="X relativ:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtXRel" Text="0" VerticalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Y relativ:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtYRel" Text="0" VerticalAlignment="Center"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Bohrtiefe:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtBohrtiefe" VerticalAlignment="Center"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Durchmesser:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDurchmesser" Text="5" VerticalAlignment="Center"/>
        </Grid>

        <!-- Bezugspunkte -->
        <GroupBox Grid.Row="1" Header="Bezugspunkte" Margin="0,12,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="CbUntenLinks"  Content="unten_links"   Margin="0,4"/>
                    <CheckBox x:Name="CbObenLinks"   Content="oben_links"    Margin="0,4"/>
                    <CheckBox x:Name="CbUntenRechts" Content="unten_rechts"  Margin="0,4"/>
                    <CheckBox x:Name="CbObenRechts"  Content="oben_rechts"   Margin="0,4"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="CbLinksMitte"  Content="links_mitte"   Margin="0,4"/>
                    <CheckBox x:Name="CbRechtsMitte" Content="rechts_mitte"  Margin="0,4"/>
                    <CheckBox x:Name="CbObenMitte"   Content="oben_mitte"    Margin="0,4"/>
                    <CheckBox x:Name="CbUntenMitte"  Content="unten_mitte"   Margin="0,4"/>
                    <CheckBox x:Name="CbMitteMitte"  Content="mitte_mitte"   Margin="0,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="75" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="Abbrechen" Width="85" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
