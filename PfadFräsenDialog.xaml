<Window x:Class="NCHops.PfadFräsenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pfad Fräsen" Width="820" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" MinWidth="640" MinHeight="480">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Parameter -->
            <RowDefinition Height="Auto"/>  <!-- Separator -->
            <RowDefinition Height="*"/>     <!-- Hauptbereich -->
            <RowDefinition Height="Auto"/>  <!-- OK/Abbrechen -->
        </Grid.RowDefinitions>

        <!-- Parameter -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Z-Tiefe:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="TxtZ" Text="-5" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Label Grid.Column="2" Content="Zustellung:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="3" x:Name="TxtZustellung" Text="3" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Label Grid.Column="4" Content="Vorschub:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="5" x:Name="TxtVorschub" Text="800" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Label Grid.Column="6" Content="Drehzahl:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="7" x:Name="TxtDrehzahl" Text="18000" VerticalAlignment="Center"/>
        </Grid>

        <Separator Grid.Row="1" Margin="0,8"/>

        <!-- Hauptbereich: links Liste, rechts Canvas -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- LINKE SEITE -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Bezugspunkt + Fräser D -->
                    <RowDefinition Height="Auto"/>  <!-- Punkt-Eingabe -->
                    <RowDefinition Height="*"/>     <!-- Punktliste -->
                    <RowDefinition Height="Auto"/>  <!-- Listenverwaltung -->
                </Grid.RowDefinitions>

                <!-- Bezugspunkt + Fräser D -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Bezugspunkt:" VerticalAlignment="Center" FontSize="11"/>
                    <ComboBox Grid.Column="1" x:Name="CbBezug" VerticalAlignment="Center" SelectedIndex="0" Margin="0,0,8,0">
                        <ComboBoxItem Content="unten_links"/>
                        <ComboBoxItem Content="oben_links"/>
                        <ComboBoxItem Content="unten_rechts"/>
                        <ComboBoxItem Content="oben_rechts"/>
                        <ComboBoxItem Content="mitte_mitte"/>
                        <ComboBoxItem Content="links_mitte"/>
                        <ComboBoxItem Content="rechts_mitte"/>
                        <ComboBoxItem Content="oben_mitte"/>
                        <ComboBoxItem Content="unten_mitte"/>
                    </ComboBox>
                    <Label Grid.Column="2" Content="Fräser D:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Column="3" x:Name="TxtFraeserD" Text="10" VerticalAlignment="Center"/>
                </Grid>

                <!-- Punkt-Eingabe -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="X:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TxtPunktX" Text="0" VerticalAlignment="Center"
                             Margin="2,0,6,0" KeyDown="OnPunktKeyDown"/>
                    <Label Grid.Column="2" Content="Y:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" x:Name="TxtPunktY" Text="0" VerticalAlignment="Center"
                             Margin="2,0,6,0" KeyDown="OnPunktKeyDown"/>
                    <Button Grid.Column="4" Content="+" Width="28" FontSize="14" FontWeight="Bold"
                            ToolTip="Punkt hinzufügen (Enter)" Click="OnHinzufügen"/>
                </Grid>

                <!-- Punktliste -->
                <ListView Grid.Row="2" x:Name="LvPunkte" BorderBrush="#CCC" BorderThickness="1"
                          SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nr." Width="38"  DisplayMemberBinding="{Binding Nr}"/>
                            <GridViewColumn Header="X (mm)" Width="100" DisplayMemberBinding="{Binding X}"/>
                            <GridViewColumn Header="Y (mm)" Width="100" DisplayMemberBinding="{Binding Y}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Listenverwaltung -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="↑" Width="32" Margin="0,0,4,0" ToolTip="Nach oben" Click="OnHoch"/>
                    <Button Content="↓" Width="32" Margin="0,0,4,0" ToolTip="Nach unten" Click="OnRunter"/>
                    <Button Content="✕" Width="32" Margin="0,0,8,0" ToolTip="Löschen" Click="OnLöschen"/>
                    <Button Content="Alle löschen" Padding="6,2" Click="OnAlleLöschen"/>
                </StackPanel>
            </Grid>

            <!-- Trennlinie -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          Background="#DDD" ResizeBehavior="PreviousAndNext"/>

            <!-- RECHTE SEITE: Live-Vorschau -->
            <Border Grid.Column="2" BorderBrush="#CCC" BorderThickness="1" Background="White">
                <Grid>
                    <Canvas x:Name="PreviewCanvas" Background="White"
                            SizeChanged="OnPreviewSizeChanged" ClipToBounds="True"/>
                    <TextBlock x:Name="TbHinweis" Text="Punkte eingeben um Vorschau zu sehen"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#AAA" FontSize="13" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- OK / Abbrechen -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="Abbrechen" Width="85" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
