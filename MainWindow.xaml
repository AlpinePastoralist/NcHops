<Window x:Class="NCHops.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="NC Studio" WindowState="Maximized"
        Width="1200" Height="700"
        Icon="icon.ico"
        Background="#d8e0ea"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>

        <!-- ── Farb-Ressourcen ────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#5c4400"/>
        <SolidColorBrush x:Key="AccentHoverBrush"  Color="#7a5c00"/>
        <SolidColorBrush x:Key="AccentPressBrush"  Color="#3a2c00"/>
        <SolidColorBrush x:Key="AccentTintBrush"   Color="#f5e8d0"/>
        <SolidColorBrush x:Key="BgBrush"           Color="#d8e0ea"/>
        <SolidColorBrush x:Key="BgLightBrush"      Color="#eaecf2"/>
        <SolidColorBrush x:Key="BgDarkBrush"       Color="#c0cad6"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#a8b4c0"/>
        <SolidColorBrush x:Key="TextDarkBrush"     Color="#2a1800"/>
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#f0e8d8"/>

        <!-- ── Button ─────────────────────────────────────────────── -->
        <Style TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentPressBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentPressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background"  Value="#998870"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#776655"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox ────────────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"             Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground"             Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="PreviewMouseLeftButtonDown"
                         Handler="TextBox_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="GotKeyboardFocus"
                         Handler="TextBox_GotKeyboardFocus"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoSelectAllTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Label ──────────────────────────────────────────────── -->
        <Style TargetType="Label">
            <Setter Property="Foreground"           Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight"           Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── CheckBox ───────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ── DataGrid ───────────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"          Value="{StaticResource BgLightBrush}"/>
            <Setter Property="RowBackground"       Value="{StaticResource BgLightBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground"          Value="{StaticResource TextDarkBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="BorderBrush"  Value="{StaticResource AccentPressBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- ── ComboBox ───────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{StaticResource BgLightBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <!-- ── Separatoren & Array ────────────────────────────────── -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <x:Array x:Key="BezugListe" Type="{x:Type sys:String}">
            <sys:String>Unten links</sys:String>
            <sys:String>Oben links</sys:String>
            <sys:String>Unten rechts</sys:String>
            <sys:String>Oben rechts</sys:String>
            <sys:String>Mitte</sys:String>
            <sys:String>Links Mitte</sys:String>
            <sys:String>Rechts Mitte</sys:String>
            <sys:String>Oben Mitte</sys:String>
            <sys:String>Unten Mitte</sys:String>
        </x:Array>

    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">

        <DockPanel Background="Transparent">

        <!-- ── Menüleiste ───────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource AccentBrush}"
              Foreground="{StaticResource TextOnAccentBrush}">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role"          Value="TopLevelHeader"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="Datei">
                <MenuItem Header="Speichern" Click="OnSpeichern"/>
                <Separator/>
                <MenuItem Header="Beenden"   Click="OnBeenden"/>
            </MenuItem>
            <MenuItem Header="Fräsen">
                <MenuItem Header="Planfräsen" Click="OnPlanfraesen"/>
                <MenuItem Header="Umfahren"   Click="OnUmfahren"/>
                <MenuItem Header="Nut"        Click="OnPlanfraesen"/>
                <MenuItem Header="Tasche"     Click="OnPlanfraesen"/>
                <MenuItem Header="Zapfen"     Click="OnPlanfraesen"/>
            </MenuItem>
            <MenuItem Header="Bohren">
                <MenuItem Header="Bohrung"            Click="OnBohrung"/>
                <MenuItem Header="Reihenlochbohrung"  Click="OnReihenlochbohrung"/>
            </MenuItem>
            <MenuItem Header="Hilfe">
                <MenuItem Header="Info" Click="OnInfo"/>
            </MenuItem>
        </Menu>

        <!-- ── Eingabebereich unten ─────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,2,0,0"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="X:"/>
                <TextBox x:Name="TxtX" Text="800" Width="70" Margin="0,0,12,0"/>
                <Label Content="Y:"/>
                <TextBox x:Name="TxtY" Text="400" Width="70" Margin="0,0,12,0"/>
                <Label Content="Z:"/>
                <TextBox x:Name="TxtZ" Text="19"  Width="70" Margin="0,0,16,0"/>
                <Button Content="Aktualisieren" Click="OnAktualisieren" Margin="0,0,24,0"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="0,0,16,0"/>
                <CheckBox x:Name="CbPfadAnzeigen" Content="Pfad Fräsen anzeigen"
                          VerticalAlignment="Center" FontWeight="SemiBold"
                          Checked="OnPfadAnzeigenChanged" Unchecked="OnPfadAnzeigenChanged"/>
            </StackPanel>
        </Border>

        <!-- ── Pfad Fräsen Panel ─────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" x:Name="PfadPanel"
                Visibility="Collapsed" Height="210"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,2,0,0"
                Background="{StaticResource AccentTintBrush}">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Parameter-Zeile -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Label Content="Z-Tiefe:"     Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtZ"          Text="-5"    Width="55" Margin="0,0,10,0"/>
                    <Label Content="Zustellung:"  Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtZustellung" Text="3"     Width="45" Margin="0,0,10,0"/>
                    <Label Content="Vorschub:"    Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtVorschub"   Text="800"   Width="55" Margin="0,0,10,0"/>
                    <Label Content="Drehzahl:"    Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtDrehzahl"   Text="18000" Width="60" Margin="0,0,10,0"/>
                    <Label Content="Fräser D:"    Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtFraeserD"   Text="10"    Width="45" Margin="0,0,10,0"/>
                    <Label Content="Standard-Bezug:" Padding="0,0,4,0"/>
                    <ComboBox x:Name="PfadCbBezug" SelectedIndex="0" Width="110"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              SelectionChanged="OnPfadParamChanged">
                        <ComboBoxItem Content="Unten links"/>
                        <ComboBoxItem Content="Oben links"/>
                        <ComboBoxItem Content="Unten rechts"/>
                        <ComboBoxItem Content="Oben rechts"/>
                        <ComboBoxItem Content="Mitte"/>
                        <ComboBoxItem Content="Links Mitte"/>
                        <ComboBoxItem Content="Rechts Mitte"/>
                        <ComboBoxItem Content="Oben Mitte"/>
                        <ComboBoxItem Content="Unten Mitte"/>
                    </ComboBox>
                    <Button Content="G-Code erzeugen" FontWeight="SemiBold"
                            Click="OnPfadGCodeErzeugen" Margin="0,0,16,0"/>
                    <Label Content="Schritt:" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtSchritt" Text="5" Width="40"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Label Content="mm" Padding="0"/>
                </StackPanel>

                <!-- Liste + Eingabe -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Punktliste -->
                    <DataGrid Grid.Column="0" x:Name="PfadLvPunkte"
                              AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Margin="0,0,6,0"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              SelectionChanged="OnPfadSelectionChanged"
                              CellEditEnding="OnPfadCellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr."    Width="38"  Binding="{Binding Nr}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="X (mm)" Width="60"  Binding="{Binding X, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Y (mm)" Width="60"  Binding="{Binding Y, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridComboBoxColumn Header="Bezug" Width="*"
                                SelectedItemBinding="{Binding Bezug, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{StaticResource BezugListe}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Eingabe + Buttons -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="X" Padding="0"/>
                            <TextBox Grid.Column="1" x:Name="PfadTxtX" Text="0"
                                     Margin="2,0,6,0" KeyDown="OnPfadPunktKeyDown"/>
                            <Label Grid.Column="2" Content="Y" Padding="0"/>
                            <TextBox Grid.Column="3" x:Name="PfadTxtY" Text="0"
                                     Margin="2,0,0,0" KeyDown="OnPfadPunktKeyDown"/>
                        </Grid>

                        <Button Grid.Row="1" Content="+ Hinzufügen"
                                Margin="0,0,0,6" Click="OnPfadHinzufügen"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="↑"   Width="30" Margin="0,0,4,0" Click="OnPfadHoch"/>
                            <Button Content="↓"   Width="30" Margin="0,0,4,0" Click="OnPfadRunter"/>
                            <Button Content="✕"   Width="30" Margin="0,0,4,0" Click="OnPfadLöschen"/>
                            <Button Content="Alle" Width="40"                  Click="OnPfadAlleLöschen"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Haupt-Splitter ────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"  MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas mit Hintergrund-Icon -->
            <Grid Grid.Column="0" Background="{StaticResource BgLightBrush}" ClipToBounds="True">
                <Canvas x:Name="DrawCanvas"
                        Background="Transparent"
                        SizeChanged="OnCanvasSizeChanged" ClipToBounds="True"
                        MouseLeftButtonDown="OnCanvasMouseDown"
                        MouseLeftButtonUp="OnCanvasMouseUp"
                        MouseMove="OnCanvasMouseMove"
                        MouseLeave="OnCanvasMouseLeave"
                        Panel.ZIndex="0"/>
                <Image x:Name="BgIcon"
                       Opacity="0.12"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Panel.ZIndex="1"/>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- G-Code Bereich -->
            <Grid Grid.Column="2" Background="{StaticResource BgLightBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Zeilennummern -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <RichTextBox x:Name="GCodeLineNumbersBox"
                                 IsReadOnly="True" IsDocumentEnabled="False"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{StaticResource AccentBrush}"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 Padding="0" BorderThickness="0" Margin="0"
                                 Background="Transparent"/>
                </Border>

                <!-- G-Code Editor -->
                <RichTextBox x:Name="GCodeBox" Grid.Column="1"
                             AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12"
                             Foreground="{StaticResource TextDarkBrush}"
                             Background="{StaticResource BgLightBrush}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="0" BorderThickness="0" Margin="0"
                             Loaded="OnGCodeBoxLoaded"
                             TextChanged="OnGCodeChanged"/>
            </Grid>
        </Grid>
        </DockPanel>
    </Grid>
</Window>
