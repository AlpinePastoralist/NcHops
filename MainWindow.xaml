<Window x:Class="NCHops.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="NC_Hops" WindowState="Maximized"
        Width="1200" Height="700"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
        </Style>
        <Style x:Key="NoSelectAllTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <x:Array x:Key="BezugListe" Type="{x:Type sys:String}">
            <sys:String>unten_links</sys:String>
            <sys:String>oben_links</sys:String>
            <sys:String>unten_rechts</sys:String>
            <sys:String>oben_rechts</sys:String>
            <sys:String>mitte_mitte</sys:String>
            <sys:String>links_mitte</sys:String>
            <sys:String>rechts_mitte</sys:String>
            <sys:String>oben_mitte</sys:String>
            <sys:String>unten_mitte</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel>
        <!-- Menüleiste -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Datei">
                <MenuItem Header="Speichern" Click="OnSpeichern"/>
                <Separator/>
                <MenuItem Header="Beenden" Click="OnBeenden"/>
            </MenuItem>
            <MenuItem Header="Fräsen">
                <MenuItem Header="Planfräsen"  Click="OnPlanfraesen"/>
                <MenuItem Header="Umfahren"    Click="OnUmfahren"/>
                <MenuItem Header="Nut"         Click="OnPlanfraesen"/>
                <MenuItem Header="Tasche"      Click="OnPlanfraesen"/>
                <MenuItem Header="Zapfen"      Click="OnPlanfraesen"/>
            </MenuItem>
            <MenuItem Header="Bohren">
                <MenuItem Header="Bohrung"           Click="OnBohrung"/>
                <MenuItem Header="Reihenlochbohrung" Click="OnReihenlochbohrung"/>
            </MenuItem>
            <MenuItem Header="Hilfe">
                <MenuItem Header="Info" Click="OnInfo"/>
            </MenuItem>
        </Menu>

        <!-- Eingabebereich unten -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Label Content="X:"/>
                <TextBox x:Name="TxtX" Text="800" Width="70" Margin="0,0,12,0"/>
                <Label Content="Y:"/>
                <TextBox x:Name="TxtY" Text="400" Width="70" Margin="0,0,12,0"/>
                <Label Content="Z:"/>
                <TextBox x:Name="TxtZ" Text="19"  Width="70" Margin="0,0,16,0"/>
                <Button Content="Aktualisieren" Padding="10,2" Click="OnAktualisieren" Margin="0,0,24,0"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,16,0"/>
                <CheckBox x:Name="CbPfadAnzeigen" Content="Pfad Fräsen anzeigen"
                          VerticalAlignment="Center" FontWeight="SemiBold"
                          Checked="OnPfadAnzeigenChanged" Unchecked="OnPfadAnzeigenChanged"/>
            </StackPanel>
        </Border>

        <!-- Pfad Fräsen Panel (ein-/ausblendbar) -->
        <Border DockPanel.Dock="Bottom" x:Name="PfadPanel"
                Visibility="Collapsed" Height="210"
                BorderBrush="#4A90D9" BorderThickness="0,2,0,0"
                Background="#F0F6FF">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Parameter-Zeile -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Label Content="Z-Tiefe:"    VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtZ"         Text="-5"   Width="55" Margin="0,0,10,0"/>
                    <Label Content="Zustellung:"  VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtZustellung" Text="3"   Width="45" Margin="0,0,10,0"/>
                    <Label Content="Vorschub:"    VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtVorschub"  Text="800"  Width="55" Margin="0,0,10,0"/>
                    <Label Content="Drehzahl:"    VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtDrehzahl"  Text="18000" Width="60" Margin="0,0,10,0"/>
                    <Label Content="Fräser D:"    VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtFraeserD"  Text="10"   Width="45" Margin="0,0,10,0"/>
                    <Label Content="Standard-Bezug:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <ComboBox x:Name="PfadCbBezug" SelectedIndex="0" Width="110" VerticalAlignment="Center" Margin="0,0,16,0"
                              SelectionChanged="OnPfadParamChanged">
                        <ComboBoxItem Content="unten_links"/>
                        <ComboBoxItem Content="oben_links"/>
                        <ComboBoxItem Content="unten_rechts"/>
                        <ComboBoxItem Content="oben_rechts"/>
                        <ComboBoxItem Content="mitte_mitte"/>
                        <ComboBoxItem Content="links_mitte"/>
                        <ComboBoxItem Content="rechts_mitte"/>
                        <ComboBoxItem Content="oben_mitte"/>
                        <ComboBoxItem Content="unten_mitte"/>
                    </ComboBox>
                    <Button Content="G-Code erzeugen" Padding="10,2"
                            Background="#4A90D9" Foreground="White" FontWeight="SemiBold"
                            Click="OnPfadGCodeErzeugen" Margin="0,0,16,0"/>
                    <Label Content="Schritt:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="PfadTxtSchritt" Text="5" Width="40" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Label Content="mm" VerticalAlignment="Center" Padding="0"/>
                </StackPanel>

                <!-- Liste + Eingabe -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Punktliste (inline editierbar) -->
                    <DataGrid Grid.Column="0" x:Name="PfadLvPunkte"
                              AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Margin="0,0,6,0"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              SelectionChanged="OnPfadSelectionChanged"
                              CellEditEnding="OnPfadCellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr."    Width="38"  Binding="{Binding Nr}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="X (mm)" Width="60" Binding="{Binding X, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="Y (mm)" Width="60" Binding="{Binding Y, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridComboBoxColumn Header="Bezug" Width="*"
                                SelectedItemBinding="{Binding Bezug, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{StaticResource BezugListe}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Eingabe + Buttons -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- X/Y Eingabe -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="X" VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Column="1" x:Name="PfadTxtX" Text="0" Margin="2,0,6,0"
                                     KeyDown="OnPfadPunktKeyDown"/>
                            <Label Grid.Column="2" Content="Y" VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Column="3" x:Name="PfadTxtY" Text="0" Margin="2,0,0,0"
                                     KeyDown="OnPfadPunktKeyDown"/>
                        </Grid>

                        <Button Grid.Row="1" Content="+ Hinzufügen" Margin="0,0,0,6"
                                Padding="4,2" Click="OnPfadHinzufügen"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="↑" Width="30" Margin="0,0,4,0" Click="OnPfadHoch"/>
                            <Button Content="↓" Width="30" Margin="0,0,4,0" Click="OnPfadRunter"/>
                            <Button Content="✕" Width="30" Margin="0,0,4,0" Click="OnPfadLöschen"/>
                            <Button Content="Alle" Width="40" Click="OnPfadAlleLöschen"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Haupt-Splitter -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"  MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas (Zeichenbereich) -->
            <Canvas x:Name="DrawCanvas" Grid.Column="0" Background="White"
                    SizeChanged="OnCanvasSizeChanged" ClipToBounds="True"
                    MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseLeftButtonUp="OnCanvasMouseUp"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeave="OnCanvasMouseLeave"/>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#DDD" ResizeBehavior="PreviousAndNext"/>

            <!-- G-Code Textfeld -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                    <RichTextBox x:Name="GCodeLineNumbersBox"
                                 IsReadOnly="True"
                                 IsDocumentEnabled="False"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="#666"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 Padding="0"
                                 BorderThickness="0"
                                 Margin="0"
                                 Background="Transparent"/>
                </Border>

                <RichTextBox x:Name="GCodeBox" Grid.Column="1" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="0"
                             BorderThickness="0"
                             Margin="0"
                             Loaded="OnGCodeBoxLoaded"
                             TextChanged="OnGCodeChanged"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
